    mu = param_pred[ii]
#     print(mu)
    s_pred= np.zeros(pred_len-tr)
    up = np.random.random()
    up = np.append(up,param_pred[ii])
    for t in range (pred_len+warmup):
        xp = (1 - alpha)*xp + alpha*np.tanh(np.dot(W_in,up) + np.dot(W, xp))   
        xpt[:] = xp[:]  
        xpt[::2] = xp[::2]**2 
        if(t>=warmup):
            pred_old = up[0]###########
            up_pred = np.dot(W_out,xpt)
            up_pred_trun = np.trunc(up_pred * 100) / 100
            if (up_pred_trun>1 or up_pred_trun<0):
                print(up_pred_trun,"*****************",mu)
            up = np.append(up_pred,param_pred[ii]) 
            pred_new = up[0]
        if(t>=warmup+tr):
            pred_data[t-(warmup),ii] = up_pred
            biff_pred.append([mu,up_pred.item()])  
            if(pred_new>pred_old):
                s_pred[t-(warmup+tr)] = +1
            if(pred_new<pred_old):
                s_pred[t-(warmup+tr)] = -1

    M_vals_pred[ii] = np.sum(s_pred) / (pred_len-tr)

np.savetxt("pred_biff.txt",biff_pred)
